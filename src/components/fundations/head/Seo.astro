---
import { AstroSeo } from "@lexingtonthemes/seo";
---

<AstroSeo
  title="Sips n Suds"
  description="Neighborhood coffee and a clean laundromat in one stop. Concrete walls, oak benches, and daylight through big windows."
  canonical="https://sipsnsuds-510519.web.app/"
  openGraph={{
    url: "https://sipsnsuds-510519.web.app/",
    title: "Sips n Suds",
    description:
      "Neighborhood coffee and a clean laundromat in one stop. Concrete walls, oak benches, and daylight through big windows.",
    site_name: "Sips n Suds",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    cardType: "summary",
  }}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://sipsnsuds-510519.web.app/" />
<meta property="og:title" content="Sips n Suds" />
<meta
  property="og:description"
  content="Neighborhood coffee and a clean laundromat in one stop. Concrete walls, oak benches, and daylight through big windows."
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary" />
<meta property="twitter:url" content="https://sipsnsuds-510519.web.app/" />
<meta property="twitter:title" content="Sips n Suds" />
<meta
  property="twitter:description"
  content="Neighborhood coffee and a clean laundromat in one stop. Concrete walls, oak benches, and daylight through big windows."
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://sipsnsuds-510519.web.app/" />

<!-- Additional SEO -->
<!-- Pre-launch: matches the X-Robots-Tag header in firebase.json. Switch both to "index, follow" when the custom domain is connected. -->
<meta name="robots" content="noindex, nofollow" />
<meta name="googlebot" content="noindex, nofollow" />
